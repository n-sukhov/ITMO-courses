<robot name="my_robots_super_model">

<material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
</material>

<material name="black">
    <color rgba="0 0 0 1"/>
</material>

    <link name="base_link"/>

    <link name="platform">
        <visual>
            <geometry>
                <box size="0.2 0.16 0.09"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.2 0.16 0.09"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="7"/>
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
    </link>

    <link name="lower_link">
