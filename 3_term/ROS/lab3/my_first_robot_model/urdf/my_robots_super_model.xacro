            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="platform"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0.0 0.0 0.0"/>
    </joint>

    <joint name="platform_left_wheel_joint" type="continuous">
        <parent link="platform"/>
        <child link="left_wheel"/>
        <origin rpy="0 0 -1.57075" xyz="-0.05 -0.095 -0.02"/>
    </joint>

    <joint name="platform_right_wheel_joint" type="continuous">
        <parent link="platform"/>
        <child link="right_wheel"/>
        <origin rpy="0 0 1.57075" xyz="-0.05 0.095 -0.02"/>
    </joint>

    <joint name="lower_link_joint" type="fixed">
        <parent link="platform"/>
        <child link="lower_link"/>
        <origin rpy="0 0 0" xyz="0.09 0.0 -0.065"/>
    </joint>

    <joint name="lower_joint" type="fixed">
        <parent link="lower_link"/>
        <child link="lower_sphere"/>
        <origin xyz="0.0 0.0 -0.025" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="platform_cyl_0_joint" type="fixed">
        <parent link="platform"/>
        <child link="cyl_0"/>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="cyl_0_sphere_0_joint" type="fixed">
        <parent link="cyl_0"/>
        <child link="sphere_0"/>
        <origin xyz="0.0 0.0 0.005" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="sphere_0_cyl_1_joint" type="revolute">
        <parent link="sphere_0"/>
        <child link="cyl_1"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57079" upper="1.57079" velocity="0.0" effort="10.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <joint name="cyl_1_sphere_1_joint" type="fixed">
        <parent link="cyl_1"/>
        <child link="sphere_1"/>
        <origin xyz="0.0 0.0 0.18" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="sphere_1_cyl_2_joint" type="revolute">
        <parent link="sphere_1"/>
        <child link="cyl_2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57079" upper="1.57079" velocity="0.0" effort="10.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <joint name="cyl_2_sphere_2_joint" type="fixed">
        <parent link="cyl_2"/>
        <child link="sphere_2"/>
        <origin xyz="0.0 0.0 0.19" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="sphere_2_right_hand_joint" type="revolute">
        <parent link="sphere_2"/>
        <child link="right_hand_0"/>
        <axis xyz="1 0 0"/>
        <limit lower="0.0" upper="1.3" velocity="0.0" effort="10.0"/>
        <origin xyz="0 0 0" rpy="0.7 0 0"/>
    </joint>

    <joint name="sphere_2_left_hand_joint" type="revolute">
        <parent link="sphere_2"/>
        <child link="left_hand_0"/>
        <axis xyz="1 0 0"/>
        <limit lower="0.0" upper="1.3" velocity="0.0" effort="10.0"/>
        <origin xyz="0 0 0" rpy="0.7 0 3.1416"/>
    </joint>

    <joint name="right_hand_middle_joint" type="fixed">
        <parent link="right_hand_0"/>
        <child link="right_hand_1"/>
        <origin xyz="0.0 -0.0018 0.067" rpy="-1.32 0.0 0.0"/>
    </joint>

    <joint name="left_hand_middle_joint" type="fixed">
        <parent link="left_hand_0"/>
        <child link="left_hand_1"/>
        <origin xyz="0.0 -0.0018 0.067" rpy="-1.32 0.0 0.0"/>
    </joint>

</robot>